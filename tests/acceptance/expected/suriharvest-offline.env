# Expected results for `accept.sh suriharvest --offline` (fixtures/suricata). Sourced by lib/suriharvest.sh.
# fixture-suri-alpha (MIT): 9000001 uri, 9000002 user-agent rev 2 (bumped to rev 3 later), 9000003 flowbit setter,
#   9000004 flowbit checker, 9000005 broken header (no destination port), 9000006 unknown keyword, 9000008 dns shared
# fixture-suri-beta (BSD-2-Clause): 9000001 different logic (sid collision), 9000008 exact copy of alpha, 9100001
#   checks a flowbit nobody sets
SURI_UNIQUE_LOGIC=8         # alpha 1,2,3,4,6,8 + beta 9000001, 9100001 (9000005 never parses, beta 9000008 = alpha)
SURI_QUARANTINE=1           # 9000005
SURI_LOAD_FAILS=1           # 9000006 (unknown keyword) fails suricata -T
SURI_EXPORT_RULES=7         # --unit logic: 8 logics minus the one that does not load
SURI_REMAPPED=1             # beta 9000001 gets a new sid with --remap-colliding-sids
SURI_ORPHAN_BIT=fx.orphan   # reported by `deps` and by export (bit without setter)
SURI_DIFF_CHANGED=1         # 9000002 rev 2 -> rev 3 between two profile builds
SURI_SHARED_SOURCES=2       # 9000008 is listed under both sources (n_sources counts independent sources: an identical copy counts as a mirror, so 1)
# --- added in harness v3 (features since the first harness) ---
SURI_RELEASE_RULES=7        # release build --engine local: same 7 rules as the merged export (enabled, loading, remapped)
SURI_COPYRIGHT_ALPHA="Copyright (c) 2026 Acceptance Fixture"      # fixtures/suricata/alpha/LICENSE + rules header
SURI_COPYRIGHT_BETA="Copyright (c) 2026 Beta Fixture Publisher"   # fixtures/suricata/beta/LICENSE + rules header
# profile 'imported' from fixtures written by lib/suriharvest.sh (suricata-update confs):
#   disable.conf: 9000002, 1:9000003 (flowbit setter), re:collide\.fixture (beta 9000001), filename:... (unsupported)
#   enable.conf:  9000003 (beats the disable.conf line, like suricata-update)
#   drop.conf:    9000003 (noalert setter: must stay alert), 9000004 (-> drop)
#   modify.conf:  9000008 domain rewrite (applied), 9000001 adds an unknown keyword (refused: does not load)
SURI_IMPORT_EXCLUSIONS=3
SURI_IMPORT_NOT_IMPORTED=1  # the filename: line
SURI_IMPORTED_RULES=5       # alpha 9000001, 9000003, 9000004 (drop), 9000008 (modified), beta 9100001
SURI_THRESHOLD_LINES=3      # suppress 9000004, threshold 9000001, event_filter on source fixture-suri-beta (9100001)
# per-major rulesets (make_fixtures.py suricata-major, served over HTTP; engines suricata-7 = real binary,
# suricata-8 = the same binary behind a wrapper that reports version 8.0.0)
SURI_MAJOR_LOGICS=4         # 9200001 (shared), 9200002 x2 (one text per major), 9200003 (8 only)
SURI_MAJOR_7=2              # suricata-7.rules: 9200001, 9200002 (major-v7 text)
SURI_MAJOR_8=3              # suricata-8.rules: 9200001, 9200002 (major-v8 text), 9200003
