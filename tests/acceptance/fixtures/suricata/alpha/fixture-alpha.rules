alert http any any -> any any (msg:"FIXTURE alpha evil uri"; flow:established,to_server; http.uri; content:"/fixture-evil"; classtype:trojan-activity; sid:9000001; rev:1;)
alert http any any -> any any (msg:"FIXTURE alpha user agent"; flow:established,to_server; http.user_agent; content:"FixtureBot"; classtype:trojan-activity; sid:9000002; rev:2;)
alert tcp any any -> any 21 (msg:"FIXTURE alpha ftp login set"; flow:established,to_server; content:"USER fixture"; flowbits:set,fx.login; flowbits:noalert; classtype:misc-activity; sid:9000003; rev:1;)
alert tcp any 21 -> any any (msg:"FIXTURE alpha ftp login ok"; flow:established,to_client; content:"230 "; flowbits:isset,fx.login; classtype:misc-activity; sid:9000004; rev:1;)
alert tcp any any -> any (msg:"FIXTURE alpha broken header, no destination port"; content:"x"; sid:9000005; rev:1;)
alert http any any -> any any (msg:"FIXTURE alpha unknown keyword"; flow:established,to_server; http.uri; content:"/kw"; fixturekw:1; sid:9000006; rev:1;)
alert dns any any -> any any (msg:"FIXTURE shared dns query"; dns.query; content:"shared.fixture.invalid"; nocase; classtype:bad-unknown; sid:9000008; rev:1;)
